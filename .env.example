# googleplay-scraper — copy to `.env` beside the scripts and fill in.
#
# Credentials live HERE, never on a command line: anything that can run `ps`
# reads a command line, and a shell keeps it in history.
#
# Precedence, highest first:
#     an explicit flag  ->  an exported environment variable  ->  .env  ->  the default
#
# `python3 env_config.py` prints what was picked up, WITHOUT printing secrets.
# It is the first thing to run when a key "isn't working".
#
# Every value below is a placeholder and is treated as UNSET, both by the
# literal and by the `{...}` shape — so a copied `.env.example` never reaches
# an API as if it were a key.

# The 2Captcha key. One key, four separately-billed products: captcha
# solving, the Scraping Browser API, proxies and fingerprints.
#
# You do not need one to read this site. Measured 2026-09-22 from a
# datacentre address, every route this repo reads answered without a key, a
# proxy or an account — see the README. If a reCAPTCHA does appear on a
# refused page, a key lets the run solve it: at most one paid solve per page.
TWOCAPTCHA_KEY=your_2captcha_api_key_here

# The Scraping Browser API endpoint, if you use one (`--cdp-endpoint`).
#
# `country-` picks the exit country, which on this site decides the rating,
# the currency and which apps are listed. `pid-` is a profile with persistent
# cookies and allows ONE live connection, so reuse pids rather than minting
# one per run, and do not raise --concurrency over a single endpoint.
#
# Profile credentials expire (how long they last varies; a 401 is the
# signal), so this is the SHAPE rather than a working endpoint: a live one
# pasted here goes stale and then produces an auth error a long way from its
# cause.
GOOGLEPLAY_CDP_ENDPOINT=ws://{login}-zone-scraping_browser-country-us-pid-{profileId}:{password}@cb.2captcha.com:9222

# A single proxy, for `--proxy`. Use `--proxy-file` for a pool.
GOOGLEPLAY_PROXY=http://{user}:{password}@us.proxy.2captcha.com:2334

# A default start URL, for `--url`. Commented out on purpose: a copied
# example should not decide what a run reads. When set, it is used only when
# neither --url nor --category/--query/--app-id/--developer is typed.
# GOOGLEPLAY_URL=https://play.google.com/store/apps/category/TOOLS
